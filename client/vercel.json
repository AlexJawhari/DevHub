{
    "rewrites": [
        {
            "source": "/((?!\\.env|\\.git|package\\.json|package-lock\\.json|yarn\\.lock|.*\\.lock|.*\\.config\\.js).*)",
            "destination": "/index.html"
        }
    ],
    "redirects": [
        {
            "source": "/config.json",
            "destination": "/404",
            "permanent": false
        },
        {
            "source": "/wp-config.php",
            "destination": "/404",
            "permanent": false
        },
        {
            "source": "/admin",
            "destination": "/404",
            "permanent": false
        },
        {
            "source": "/debug",
            "destination": "/404",
            "permanent": false
        },
        {
            "source": "/.htaccess",
            "destination": "/404",
            "permanent": false
        },
        {
            "source": "/backup.sql",
            "destination": "/404",
            "permanent": false
        },
        {
            "source": "/composer.json",
            "destination": "/404",
            "permanent": false
        },
        {
            "source": "/requirements.txt",
            "destination": "/404",
            "permanent": false
        },
        {
            "source": "/go.sum",
            "destination": "/404",
            "permanent": false
        },
        {
            "source": "/node_modules/.package-lock.json",
            "destination": "/404",
            "permanent": false
        },
        {
            "source": "/.npmrc",
            "destination": "/404",
            "permanent": false
        },
        {
            "source": "/.yarnrc",
            "destination": "/404",
            "permanent": false
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), payment=()"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://devhub-ndjh.onrender.com https://vitals.vercel-insights.com;"
                },
                {
                    "key": "Server",
                    "value": "Web Server"
                }
            ]
        }
    ]
}